---
import '../index.css'

type StructuredData = Record<string, unknown>

interface Props {
  title: string
  description: string
  canonicalPath: string
  noindex?: boolean
  type?: 'website' | 'article'
  publishedTime?: Date
  modifiedTime?: Date
  structuredData?: StructuredData | StructuredData[]
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData = [],
} = Astro.props

const canonical = new URL(canonicalPath, Astro.site)
const socialImage = new URL('/social-card.png', Astro.site)
const jsonLdItems = Array.isArray(structuredData) ? structuredData : [structuredData]
const robots = noindex
  ? 'noindex,follow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#02241a" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Azeret+Mono:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="MicroAlchemy Blog RSS" href="/rss.xml" />

    <meta property="og:site_name" content="MicroAlchemy" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MicroAlchemy — rapid silicon prototyping" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="MicroAlchemy — rapid silicon prototyping" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    {jsonLdItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body>
    <slot />
  </body>
</html>
