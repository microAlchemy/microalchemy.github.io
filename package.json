{
  "name": "microalchemy-site",
  "version": "2.0.0",
  "description": "MicroAlchemy marketing site and MDX blog",
  "main": "index.js",
  "homepage": "https://microalchemy.xyz",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run lint:blog && npm run rss",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint:blog": "node scripts/check-blog-frontmatter.mjs",
    "rss": "node scripts/generate-rss.mjs",
    "intake:check": "tsc -p worker/tsconfig.json",
    "intake:build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir .wrangler/dry-run",
    "intake:dev": "wrangler dev --config worker/wrangler.jsonc --var ALLOWED_ORIGINS:http://localhost:5173",
    "intake:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "check": "npm run build && (git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git diff --exit-code --stat || echo \"Skipping git diff (repository not available)\")",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@tabler/icons": "^3.46.0",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
