{
  "name": "microalchemy-site",
  "version": "2.0.0",
  "description": "MicroAlchemy marketing site and MDX blog",
  "homepage": "https://microalchemy.xyz",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-seo-output.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "social-card": "node scripts/generate-social-card.mjs",
    "intake:check": "tsc -p worker/tsconfig.json",
    "intake:test": "node --test worker/test/*.test.mjs && npm run intake:build && node worker/test/runtime.mjs",
    "intake:build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir .wrangler/dry-run",
    "intake:dev": "wrangler dev --config worker/wrangler.jsonc --var ALLOWED_ORIGINS:http://localhost:4321",
    "intake:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "check": "npm run build && npm run intake:check",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tabler/icons": "^3.46.0",
    "libphonenumber-js": "^1.13.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.3.1",
    "gh-pages": "^6.3.0",
    "marked": "^18.0.11",
    "miniflare": "^5.20260907.0-alpha",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.128.0",
    "zod": "^4.5.4"
  }
}
